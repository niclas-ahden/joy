{
	admin off
	auto_https off
	persist_config off

	log {
		level ERROR
	}
}

:{$JOY_WATCH_PORT:8000} {
	root * www
	file_server

	# disable cache since runtime.js fetches app.wasm, which means a stale one may survive even
  # a hard refresh in some browsers
	header Cache-Control "no-cache"

	# The browser tests navigate to /todomvc/, the app's path on Joy's own
	# dev server, so the same tests run unchanged against either server
	handle_path /todomvc/* {
		root * www
		file_server
	}
}
