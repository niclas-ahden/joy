+take7 = |b| Ok({ val: take6(b)?.val, rest: take6(b)?.rest })
+take8 = |b| Ok({ val: take7(b)?.val, rest: take7(b)?.rest })
+take9 = |b| Ok({ val: take8(b)?.val, rest: take8(b)?.rest })
